{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Markdown notes app for macOS",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "node scripts/build.mjs --serve",
    "build:ui": "node scripts/build.mjs",
    "tauri": "tauri",
    "gen:types": "cargo test -p app export_bindings",
    "typecheck": "tsc -p .",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "test": "cargo test --workspace",
    "check": "cargo fmt --all --check && pnpm test && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
