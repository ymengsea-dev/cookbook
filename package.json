{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Markdown notes app for macOS",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "node scripts/build.mjs --serve",
    "build:ui": "node scripts/build.mjs",
    "tauri": "tauri",
    "gen:types": "cargo test -p app export_bindings",
    "typecheck": "tsc -p .",
    "lint": "eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "test": "cargo test --workspace && pnpm test:ui",
    "check": "cargo fmt --all --check && pnpm test && pnpm typecheck && pnpm lint",
    "test:ui": "node --experimental-strip-types --test \"ui/src/**/*.test.ts\"",
    "sync:commands": "node scripts/sync-commands.mjs",
    "bench": "cargo run --release -p vault-index --example bench"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
