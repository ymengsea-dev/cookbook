{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Markdown notes app for macOS",
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"packages/*/src/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
